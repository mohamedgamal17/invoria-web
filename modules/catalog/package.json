{
  "name": "@invoria/catalog",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "dependencies": {
    "@invoria/core": "*",
    "@invoria/utils": "*",
    "@invoria/ui": "*",
    "@invoria/inventory": "*",
    "@invoria/sales": "*",
    "@invoria/event-bus": "*"
  },
  "peerDependencies": {
    "@angular/core": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngrx/store": "^22.0.1",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/router-store": "^22.0.1",
    "lucide-angular": "^0.577.0",
    "primeng": "^21.1.3",
    "rxjs": "~7.8.0"
  },
  "scripts": {
    "test": "npx ng test --watch=false --include=\"modules/catalog/src/**/*.spec.ts\"",
    "check:stories": "node ../../scripts/check-story-coverage.mjs --module=catalog",
    "storybook": "node ../../scripts/generate-storybook-gallery.mjs && ng run invoria-web:storybook --config-dir=../../.storybook/modules/catalog --port=6102",
    "build-storybook": "node ../../scripts/generate-storybook-gallery.mjs && ng run invoria-web:build-storybook --config-dir=../../.storybook/modules/catalog --output-dir=../../dist/storybook/catalog",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
