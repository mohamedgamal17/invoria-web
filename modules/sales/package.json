{
  "name": "@invoria/sales",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "dependencies": {
    "@invoria/core": "*",
    "@invoria/utils": "*",
    "@invoria/ui": "*",
    "@invoria/event-bus": "*",
    "@invoria/customers": "*",
    "@invoria/catalog": "*"
  },
  "peerDependencies": {
    "@angular/core": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngrx/store": "^22.0.1",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/router-store": "^22.0.1",
    "echarts": "^6.1.0",
    "lucide-angular": "^0.577.0",
    "ngx-echarts": "^21.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.3",
    "rxjs": "~7.8.0"
  },
  "scripts": {
    "test": "npx ng test --watch=false --include=\"modules/sales/src/**/*.spec.ts\"",
    "test:orders": "npx ng test --watch=false --include=\"modules/sales/src/orders/**/*.spec.ts\"",
    "test:invoices": "npx ng test --watch=false --include=\"modules/sales/src/invoices/**/*.spec.ts\"",
    "test:returns": "npx ng test --watch=false --include=\"modules/sales/src/returns/**/*.spec.ts\"",
    "check:stories": "node ../../scripts/check-story-coverage.mjs --module=sales",
    "storybook": "node ../../scripts/generate-storybook-gallery.mjs && ng run invoria-web:storybook --config-dir=../../.storybook/modules/sales --port=6107",
    "build-storybook": "node ../../scripts/generate-storybook-gallery.mjs && ng run invoria-web:build-storybook --config-dir=../../.storybook/modules/sales --output-dir=../../dist/storybook/sales",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
