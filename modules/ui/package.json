{
  "name": "@invoria/ui",
  "version": "0.0.1",
  "private": true,
  "sideEffects": false,
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "dependencies": {
    "@invoria/core": "*",
    "@invoria/utils": "*"
  },
  "peerDependencies": {
    "@angular/core": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@primeuix/themes": "^2.0.3",
    "echarts": "^6.1.0",
    "lucide-angular": "^0.577.0",
    "ngx-echarts": "^21.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.3",
    "rxjs": "~7.8.0"
  },
  "scripts": {
    "test": "npx ng test --watch=false --include=\"modules/ui/src/**/*.spec.ts\"",
    "check:stories": "node ../../scripts/check-story-coverage.mjs --module=ui",
    "storybook": "node ../../scripts/generate-storybook-gallery.mjs && ng run invoria-web:storybook --config-dir=../../.storybook/modules/ui --port=6101",
    "build-storybook": "node ../../scripts/generate-storybook-gallery.mjs && ng run invoria-web:build-storybook --config-dir=../../.storybook/modules/ui --output-dir=../../dist/storybook/ui",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
