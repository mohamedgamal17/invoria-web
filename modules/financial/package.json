{
  "name": "@invoria/financial",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "dependencies": {
    "@invoria/core": "*",
    "@invoria/utils": "*",
    "@invoria/ui": "*",
    "@invoria/event-bus": "*",
    "@invoria/sales": "*",
    "@invoria/procurement": "*"
  },
  "peerDependencies": {
    "@angular/core": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ngrx/store": "^21.0.0",
    "@ngrx/effects": "^21.0.0",
    "lucide-angular": "^0.577.0",
    "primeng": "^21.1.3",
    "rxjs": "~7.8.0"
  },
  "scripts": {
    "test": "npx ng test --watch=false --include=\"modules/financial/src/**/*.spec.ts\"",
    "test:payables": "npx ng test --watch=false --include=\"modules/financial/src/payables/**/*.spec.ts\"",
    "test:receivables": "npx ng test --watch=false --include=\"modules/financial/src/receivables/**/*.spec.ts\"",
    "check:stories": "node ../../scripts/check-story-coverage.mjs --module=financial",
    "storybook": "node ../../scripts/generate-storybook-gallery.mjs && ng run invoria-web:storybook --config-dir=../../.storybook/modules/financial --port=6104",
    "build-storybook": "node ../../scripts/generate-storybook-gallery.mjs && ng run invoria-web:build-storybook --config-dir=../../.storybook/modules/financial --output-dir=../../dist/storybook/financial",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
