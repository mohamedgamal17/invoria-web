{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "modules",
  "projects": {
    "invoria-web": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "modules",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "modules/shell/src/main.ts",
            "index": "modules/shell/src/index.html",
            "tsConfig": "modules/shell/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "modules/shell/public"
              }
            ],
            "styles": ["modules/shell/src/styles.css"]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "modules/shell/src/environments/environment.ts",
                  "with": "modules/shell/src/environments/environment.production.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.5mb",
                  "maximumError": "3.5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "fileReplacements": [
                {
                  "replace": "modules/shell/src/environments/environment.ts",
                  "with": "modules/shell/src/environments/environment.development.ts"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "invoria-web:build:production"
            },
            "development": {
              "buildTarget": "invoria-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "modules/shell/tsconfig.spec.json",
            "include": ["modules/**/src/**/*.spec.ts"]
          }
        }
      }
    }
  }
}
