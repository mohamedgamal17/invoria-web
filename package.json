{
  "name": "invoria-web",
  "private": true,
  "workspaces": [
    "modules/core",
    "modules/utils",
    "modules/event-bus",
    "modules/ui",
    "modules/customers",
    "modules/sales",
    "modules/inventory",
    "modules/catalog",
    "modules/financial",
    "modules/procurement",
    "modules/shell"
  ],
  "scripts": {
    "ng": "ng",
    "install:all": "npm install",
    "start": "ng serve",
    "build": "node ./scripts/generate-production-env.mjs && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:core": "npx ng test --watch=false --include=\"modules/core/src/**/*.spec.ts\"",
    "test:utils": "npx ng test --watch=false --include=\"modules/utils/src/**/*.spec.ts\"",
    "test:ui": "npx ng test --watch=false --include=\"modules/ui/src/**/*.spec.ts\"",
    "test:event-bus": "npx ng test --watch=false --include=\"modules/event-bus/src/**/*.spec.ts\"",
    "test:customers": "npx ng test --watch=false --include=\"modules/customers/src/**/*.spec.ts\"",
    "test:sales": "npx ng test --watch=false --include=\"modules/sales/src/**/*.spec.ts\"",
    "test:inventory": "npx ng test --watch=false --include=\"modules/inventory/src/**/*.spec.ts\"",
    "test:catalog": "npx ng test --watch=false --include=\"modules/catalog/src/**/*.spec.ts\"",
    "test:financial": "npx ng test --watch=false --include=\"modules/financial/src/**/*.spec.ts\"",
    "test:procurement": "npx ng test --watch=false --include=\"modules/procurement/src/**/*.spec.ts\"",
    "test:shell": "npx ng test --watch=false --include=\"modules/shell/src/**/*.spec.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "format": "npx prettier --write"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@primeng/mcp": "^21.1.3",
    "@tailwindcss/postcss": "^4.1.12",
    "@vitest/ui": "^4.1.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@primeng/mcp": {
      "@modelcontextprotocol/sdk": "1.27.0"
    }
  }
}
