{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "baseUrl": ".",
    "paths": {
      "@invoria/core": ["modules/core/src/index.ts"],
      "@invoria/core/*": ["modules/core/src/*"],
      "@invoria/utils": ["modules/utils/src/index.ts"],
      "@invoria/utils/*": ["modules/utils/src/*"],
      "@invoria/ui": ["modules/ui/src/index.ts"],
      "@invoria/ui/*": ["modules/ui/src/*"],
      "@invoria/event-bus": ["modules/event-bus/src/index.ts"],
      "@invoria/event-bus/*": ["modules/event-bus/src/*"],
      "@invoria/customers": ["modules/customers/src/index.ts"],
      "@invoria/customers/*": ["modules/customers/src/*"],
      "@invoria/sales": ["modules/sales/src/index.ts"],
      "@invoria/sales/*": ["modules/sales/src/*"],
      "@invoria/inventory": ["modules/inventory/src/index.ts"],
      "@invoria/inventory/*": ["modules/inventory/src/*"],
      "@invoria/catalog": ["modules/catalog/src/index.ts"],
      "@invoria/catalog/*": ["modules/catalog/src/*"],
      "@invoria/financial": ["modules/financial/src/index.ts"],
      "@invoria/financial/*": ["modules/financial/src/*"],
      "@invoria/procurement": ["modules/procurement/src/index.ts"],
      "@invoria/procurement/*": ["modules/procurement/src/*"],
      "@invoria/shell": ["modules/shell/src/main.ts"],
      "@invoria/shell/*": ["modules/shell/src/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    { "path": "./modules/shell/tsconfig.app.json" },
    { "path": "./modules/shell/tsconfig.spec.json" }
  ]
}
